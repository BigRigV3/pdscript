badge.Parent = topbar
corner(badge, 9)


-- ── watermark ────────────────────────────────────────────────────────────
local wm = Instance.new("Frame")
wm.Name = "watermark"
wm.Size = UDim2.fromOffset(300, 22)
wm.Position = UDim2.fromOffset(16, 14)
wm.BackgroundColor3 = THEME.Bg
wm.BackgroundTransparency = 0.15
wm.BorderSizePixel = 0
wm.Parent = gui
corner(wm, 6)
stroke(wm)

local wmText = Instance.new("TextLabel")
wmText.BackgroundTransparency = 1
wmText.Size = UDim2.new(1, -12, 1, 0)
wmText.Position = UDim2.fromOffset(6, 0)
wmText.Font = Enum.Font.Code
wmText.TextSize = 12
wmText.TextColor3 = THEME.Text
wmText.TextXAlignment = Enum.TextXAlignment.Left
wmText.Text = "typeshit.cc private"
wmText.Parent = wm

local wmFrames, wmTime, wmFps = 0, 0, 60
connections[#connections + 1] = RunService.Heartbeat:Connect(function(dt)
    wmFrames = wmFrames + 1
    wmTime = wmTime + (dt or 0)
    if wmTime >= 0.5 then
        wmFps = math.floor(wmFrames / wmTime + 0.5)
        wmFrames, wmTime = 0, 0
        local ms = 0
        pcall(function()
            ms = math.floor(LocalPlayer:GetNetworkPing() * 2000 + 0.5)
        end)
        wmText.Text = string.format("typeshit.cc private | %d fps | %d ms | %d players",
            wmFps, ms, #Players:GetPlayers())
    end
end)

-- ── window buttons + drag ────────────────────────────────────────────────
local bodyVisible = true
local function smallBtn(text, x)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(26, 26)
    b.Position = UDim2.new(1, x, 0, 6)
    b.BackgroundColor3 = THEME.Row
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.TextColor3 = THEME.Text
    b.Text = text
    b.BorderSizePixel = 0
    b.Parent = topbar
    corner(b, 6)
    return b
end

local minimizeBtn = smallBtn("-", -66)
local closeBtn = smallBtn("x", -34)

minimizeBtn.MouseButton1Click:Connect(function()
    bodyVisible = not bodyVisible
    window.Size = bodyVisible and UDim2.fromOffset(660, 440)
        or UDim2.fromOffset(660, 38)
end)

closeBtn.MouseButton1Click:Connect(function()
    gui:Destroy() -- closes the menu only; the ESP keeps running
end)

local dragging, dragStart, startPos = false, nil, nil
topbar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = window.Position
    end
end)
connections[#connections + 1] = UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local dx = input.Position.X - dragStart.X
        local dy = input.Position.Y - dragStart.Y
        window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + dx,
            startPos.Y.Scale, startPos.Y.Offset + dy)
    end
end)


-- ── sidebar + pages ──────────────────────────────────────────────────────
local sidebar = Instance.new("Frame")
sidebar.Name = "sidebar"
sidebar.Size = UDim2.new(0, 150, 1, -38)
sidebar.Position = UDim2.fromOffset(0, 38)
sidebar.BackgroundColor3 = THEME.Panel
sidebar.BorderSizePixel = 0
sidebar.Parent = window

local content = Instance.new("Frame")
content.Name = "content"
content.Size = UDim2.new(1, -150, 1, -38)
content.Position = UDim2.fromOffset(150, 38)
content.BackgroundTransparency = 1
content.Parent = window

local TAB_NAMES = { "Visuals", "Chams", "Players", "Settings" }
local pages, tabButtons = {}, {}

local openDropdown = nil
local activeSlider = nil

local function closeDropdowns()
    if openDropdown then
        openDropdown.list.Visible = false
        openDropdown = nil
    end
end

local function makePage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.Size = UDim2.new(1, -18, 1, -14)
    page.Position = UDim2.fromOffset(10, 8)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = THEME.Accent
    page.CanvasSize = UDim2.fromOffset(0, 0)
    page.Visible = false
    page.Parent = content
    page.nextY = 4
    pages[name] = page
    return page
end

local function selectTab(name)
    for tabName, page in pairs(pages) do
        page.Visible = (tabName == name)
    end
    for tabName, btn in pairs(tabButtons) do
        btn.TextColor3 = (tabName == name) and THEME.Accent or THEME.Dim
    end
    closeDropdowns()
end

for i, name in ipairs(TAB_NAMES) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -12, 0, 32)
    btn.Position = UDim2.fromOffset(6, (i - 1) * 36 + 6)
    btn.BackgroundColor3 = THEME.Bg
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextColor3 = THEME.Dim
    btn.Text = name
    btn.Parent = sidebar
    corner(btn, 6)
    tabButtons[name] = btn
    btn.MouseButton1Click:Connect(function() selectTab(name) end)
    makePage(name)
end

-- ── row builders ─────────────────────────────────────────────────────────
local function addRow(page, h)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, h)
    row.Position = UDim2.fromOffset(0, page.nextY)
    row.BackgroundColor3 = THEME.Row
    row.BorderSizePixel = 0
    row.Parent = page
    corner(row, 6)
    page.nextY = page.nextY + h + 6
    page.CanvasSize = UDim2.fromOffset(0, page.nextY)
    return row
end

local function addSection(page, name)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -4, 0, 16)
    l.Position = UDim2.fromOffset(4, page.nextY)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamBold
    l.TextSize = 11
    l.TextColor3 = THEME.Accent
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Text = string.upper(name)
    l.Parent = page
    page.nextY = page.nextY + 22
    page.CanvasSize = UDim2.fromOffset(0, page.nextY)
end

local function addInfo(page, text)
    local row = addRow(page, 24)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size = UDim2.new(1, -20, 1, 0)
    l.Position = UDim2.fromOffset(10, 0)
    l.Font = Enum.Font.Code
    l.TextSize = 12
    l.TextColor3 = THEME.Dim
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Text = text
    l.Parent = row
    return row
end

local function addButton(page, text, cb)
    local row = addRow(page, 32)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 1, -10)
    btn.Position = UDim2.fromOffset(10, 5)
    btn.BackgroundColor3 = THEME.AccentDim
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextColor3 = THEME.Text
    btn.Text = text
    btn.Parent = row
    corner(btn, 6)
    btn.MouseButton1Click:Connect(function()
        pcall(cb)
    end)
end


-- ── controls: toggle ─────────────────────────────────────────────────────
local function addToggle(page, text, get, set)
    local row = addRow(page, 30)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -70, 1, 0)
    lbl.Position = UDim2.fromOffset(10, 0)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextColor3 = THEME.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = text
    lbl.Parent = row

    local pill = Instance.new("Frame")
    pill.Size = UDim2.fromOffset(36, 18)
    pill.Position = UDim2.new(1, -46, 0.5, -9)
    pill.BackgroundColor3 = get() and THEME.Accent or THEME.Off
    pill.BorderSizePixel = 0
    pill.Parent = row
    corner(pill, 9)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(12, 12)
    knob.Position = get() and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
    knob.BorderSizePixel = 0
    knob.Parent = pill
    corner(knob, 6)

    local btn = Instance.new("TextButton")
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.Text = ""
    btn.Parent = row
    btn.MouseButton1Click:Connect(function()
        local state = not get()
        set(state)
        pill.BackgroundColor3 = state and THEME.Accent or THEME.Off
        knob.Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
    end)
end

-- ── controls: slider (shared drag engine) ────────────────────────────────
connections[#connections + 1] = UserInputService.InputChanged:Connect(function(input)
    if activeSlider and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local s = activeSlider
        local absW = s.track.AbsoluteSize.X
        if absW > 0 then
            local a = (input.Position.X - s.track.AbsolutePosition.X) / absW
            local v = s.min + (s.max - s.min) * clamp(a, 0, 1)
            if s.step and s.step > 0 then
                v = math.floor(v / s.step + 0.5) * s.step
            end
            s.apply(v)
            if s.paint then s.paint() end
        end
    end
end)
connections[#connections + 1] = UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        activeSlider = nil
    end
end)

local function buildSliderTrack(parent, y, width, min, max, step, get, apply, format)
    local track = Instance.new("Frame")
    track.Size = UDim2.fromOffset(width, 6)
    track.Position = UDim2.fromOffset(10, y)
    track.BackgroundColor3 = THEME.Off
    track.BorderSizePixel = 0
    track.Parent = parent
    corner(track, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = THEME.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 3)

    local paint
    paint = function()
        local a = clamp((get() - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(a, 0, 1, 0)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = {
                track = track, min = min, max = max, step = step,
                apply = apply, paint = paint,
            }
        end
    end)
    paint()
    return track, paint
end

local function addSlider(page, text, min, max, decimals, step, get, set)
    local row = addRow(page, 42)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -90, 0, 16)
    lbl.Position = UDim2.fromOffset(10, 3)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextColor3 = THEME.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = text
    lbl.Parent = row

    local val = Instance.new("TextLabel")
    val.BackgroundTransparency = 1
    val.Size = UDim2.fromOffset(70, 16)
    val.Position = UDim2.new(1, -80, 0, 3)
    val.Font = Enum.Font.Code
    val.TextSize = 12
    val.TextColor3 = THEME.Dim
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Text = ""
    val.Parent = row

    local track, paint = buildSliderTrack(row, 26, 200, min, max, step, get,
        function(v)
            set(v)
            val.Text = string.format("%." .. decimals .. "f", get())
        end)
    val.Text = string.format("%." .. decimals .. "f", get())
end


-- ── controls: dropdown ───────────────────────────────────────────────────
local function addDropdown(page, text, options, get, set)
    local row = addRow(page, 48)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -20, 0, 14)
    lbl.Position = UDim2.fromOffset(10, 3)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextColor3 = THEME.Dim
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = text
    lbl.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 24)
    btn.Position = UDim2.fromOffset(10, 19)
    btn.BackgroundColor3 = THEME.Panel
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.TextColor3 = THEME.Text
    btn.Text = tostring(get())
    btn.Parent = row
    corner(btn, 6)
    stroke(btn)

    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, 0, 0, #options * 22)
    list.Position = UDim2.new(0, 0, 1, 2)
    list.BackgroundColor3 = THEME.Bg
    list.BorderSizePixel = 0
    list.Visible = false
    list.ZIndex = 50
    list.Parent = btn
    corner(list, 6)
    stroke(list)

    for i, opt in ipairs(options) do
        local label, value = opt, opt
        if type(opt) == "table" then
            label, value = opt[1], opt[2]
        end
        local ob = Instance.new("TextButton")
        ob.Size = UDim2.new(1, 0, 0, 22)
        ob.Position = UDim2.fromOffset(0, (i - 1) * 22)
        ob.BackgroundColor3 = THEME.Panel
        ob.BorderSizePixel = 0
        ob.Font = Enum.Font.Gotham
        ob.TextSize = 12
        ob.TextColor3 = THEME.Text
        ob.Text = tostring(label)
        ob.ZIndex = 51
        ob.Parent = list
        ob.MouseButton1Click:Connect(function()
            set(value)
            btn.Text = tostring(label)
            closeDropdowns()
        end)
    end

    btn.MouseButton1Click:Connect(function()
        if openDropdown and openDropdown.list == list then
            closeDropdowns()
        else
            closeDropdowns()
            list.Visible = true
            openDropdown = { list = list }
        end
    end)
end


-- ── controls: color picker ───────────────────────────────────────────────
local colorEditor = Instance.new("Frame")
colorEditor.Size = UDim2.fromOffset(196, 170)
colorEditor.Position = UDim2.new(1, -206, 0.5, -85)
colorEditor.BackgroundColor3 = THEME.Panel
colorEditor.BorderSizePixel = 0
colorEditor.Visible = false
colorEditor.ZIndex = 80
colorEditor.Parent = window
corner(colorEditor, 8)
stroke(colorEditor)

local colorTitle = Instance.new("TextLabel")
colorTitle.BackgroundTransparency = 1
colorTitle.Size = UDim2.new(1, -60, 0, 16)
colorTitle.Position = UDim2.fromOffset(10, 6)
colorTitle.Font = Enum.Font.GothamBold
colorTitle.TextSize = 12
colorTitle.TextColor3 = THEME.Text
colorTitle.TextXAlignment = Enum.TextXAlignment.Left
colorTitle.Text = "color picker"
colorTitle.ZIndex = 81
colorTitle.Parent = colorEditor

local colorPreview = Instance.new("Frame")
colorPreview.Size = UDim2.fromOffset(24, 16)
colorPreview.Position = UDim2.new(1, -34, 0, 6)
colorPreview.BackgroundColor3 = THEME.Accent
colorPreview.BorderSizePixel = 0
colorPreview.ZIndex = 81
colorPreview.Parent = colorEditor
corner(colorPreview, 4)

local rgbv = { 255, 95, 95 }
local colorState = nil -- { swatch = frame, set = function }

local function editorApply()
    local c = Color3.fromRGB(rgbv[1], rgbv[2], rgbv[3])
    colorPreview.BackgroundColor3 = c
    if colorState then
        if colorState.swatch then
            colorState.swatch.BackgroundColor3 = c
        end
        colorState.set(c)
    end
end

local CHANNELS = { "R", "G", "B" }
for i = 1, 3 do
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.fromOffset(14, 14)
    lbl.Position = UDim2.fromOffset(10, 30 + (i - 1) * 26)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextColor3 = THEME.Dim
    lbl.Text = CHANNELS[i]
    lbl.ZIndex = 81
    lbl.Parent = colorEditor

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -76, 0, 6)
    track.Position = UDim2.fromOffset(30, 34 + (i - 1) * 26)
    track.BackgroundColor3 = THEME.Off
    track.BorderSizePixel = 0
    track.ZIndex = 81
    track.Parent = colorEditor
    corner(track, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = THEME.Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 82
    fill.Parent = track
    corner(fill, 3)

    local valLabel = Instance.new("TextLabel")
    valLabel.BackgroundTransparency = 1
    valLabel.Size = UDim2.fromOffset(28, 14)
    valLabel.Position = UDim2.new(1, -38, 0, -4)
    valLabel.Font = Enum.Font.Code
    valLabel.TextSize = 11
    valLabel.TextColor3 = THEME.Dim
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.Text = "255"
    valLabel.ZIndex = 81
    valLabel.Parent = track

    local paint = function()
        fill.Size = UDim2.new(rgbv[i] / 255, 0, 1, 0)
        valLabel.Text = tostring(rgbv[i])
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = {
                track = track, min = 0, max = 255, step = 1,
                apply = function(v)
                    rgbv[i] = math.floor(v + 0.5)
                    editorApply()
                end,
                paint = paint,
            }
        end
    end)
    paint()
end

local doneBtn = Instance.new("TextButton")
doneBtn.Size = UDim2.new(1, -20, 0, 22)
doneBtn.Position = UDim2.fromOffset(10, 134)
doneBtn.BackgroundColor3 = THEME.Accent
doneBtn.BorderSizePixel = 0
doneBtn.Font = Enum.Font.GothamBold
doneBtn.TextSize = 12
doneBtn.TextColor3 = Color3.fromRGB(22, 10, 10)
doneBtn.Text = "done"
doneBtn.ZIndex = 81
doneBtn.Parent = colorEditor
corner(doneBtn, 6)
doneBtn.MouseButton1Click:Connect(function()
    colorEditor.Visible = false
    colorState = nil
end)

local function addColor(page, text, get, set)
    local row = addRow(page, 30)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -70, 1, 0)
    lbl.Position = UDim2.fromOffset(10, 0)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextColor3 = THEME.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = text
    lbl.Parent = row

    local swatch = Instance.new("Frame")
    swatch.Size = UDim2.fromOffset(26, 18)
    swatch.Position = UDim2.new(1, -36, 0.5, -9)
    swatch.BackgroundColor3 = get()
    swatch.BorderSizePixel = 0
    swatch.Parent = row
    corner(swatch, 4)

    local btn = Instance.new("TextButton")
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.Text = ""
    btn.Parent = row
    btn.MouseButton1Click:Connect(function()
        local c = get()
        rgbv[1] = math.floor(c.R * 255 + 0.5)
        rgbv[2] = math.floor(c.G * 255 + 0.5)
        rgbv[3] = math.floor(c.B * 255 + 0.5)
        colorState = { swatch = swatch, set = set }
        colorEditor.Visible = true
        editorApply()
    end)
end

-- ── menu keybind ─────────────────────────────────────────────────────────
connections[#connections + 1] = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == MENU_KEY then
        window.Visible = not window.Visible
    end
end)


