--[[═════════════════════════════════════════════════════════════════════════
    typeshit.cc private — menu • TypeShit ESP v1.2
    ──────────────────────────────────────────────────────────────────────────
    Menu frontend for the TypeShit ESP core (EspLib.lua).

    USAGE
      1. Execute EspLib.lua (the ESP core).
      2. Execute this file — the typeshit.cc private menu opens.
      3. RightControl toggles the menu. Every control writes straight into
         EspLib.Config, so changes apply live.

    TABS
      Visuals   boxes / health bar / text / skeleton options
      Chams     occluded highlight options
      Players   per-player ESP on/off list
      Settings  filters, actions, full unload
════════════════════════════════════════════════════════════════════════════]]

local GLOBAL = _G
pcall(function()
    local g = getgenv and getgenv()
    if type(g) == "table" then GLOBAL = g end
end)

-- clean re-execution: destroy a previous menu instance
do
    local prev = GLOBAL.TypeShitUI
    if type(prev) == "table" and type(prev.Destroy) == "function" then
        pcall(prev.Destroy)
    end
end

local EspLib = GLOBAL.EspLib
assert(type(EspLib) == "table", "[typeshit.cc] load EspLib.lua before example.lua")
local Config = EspLib.Config

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local MENU_KEY = Enum.KeyCode.RightControl

local THEME = {
    Accent    = Color3.fromRGB(255, 95, 95),
    AccentDim = Color3.fromRGB(96, 38, 42),
    Bg        = Color3.fromRGB(15, 15, 19),
    Panel     = Color3.fromRGB(22, 22, 28),
    Row       = Color3.fromRGB(27, 27, 34),
    Stroke    = Color3.fromRGB(46, 46, 58),
    Text      = Color3.fromRGB(236, 236, 242),
    Dim       = Color3.fromRGB(148, 148, 160),
    Off       = Color3.fromRGB(66, 66, 80),
}

local function clamp(v, lo, hi)
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

-- ── root gui ─────────────────────────────────────────────────────────────
local gui = Instance.new("ScreenGui")
gui.Name = "typeshit.cc"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 10000
gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
do
    local ok = pcall(function()
        gui.Parent = (type(gethui) == "function") and gethui()
            or game:GetService("CoreGui")
    end)
    if not ok or not gui.Parent then
        pcall(function()
            gui.Parent = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
        end)
    end
end

local connections = {}

-- ── small builders ───────────────────────────────────────────────────────
local function corner(parent, px)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, px or 6)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or THEME.Stroke
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end

-- ── window ───────────────────────────────────────────────────────────────
local window = Instance.new("Frame")
window.Name = "typeshit_window"
window.Size = UDim2.fromOffset(660, 440)
window.Position = UDim2.new(0.5, -330, 0.5, -220)
window.BackgroundColor3 = THEME.Bg
window.BorderSizePixel = 0
window.Active = true
window.Parent = gui
corner(window, 10)
stroke(window)

local topbar = Instance.new("Frame")
topbar.Name = "topbar"
topbar.Size = UDim2.new(1, 0, 0, 38)
topbar.BackgroundColor3 = THEME.Panel
topbar.BorderSizePixel = 0
topbar.Parent = window
corner(topbar, 10)

