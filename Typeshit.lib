-- ── PLAYERS TAB ──────────────────────────────────────────────────────────
local playerRows = 0

local function rebuildPlayers()
    local page = pages.Players
    for _, c in ipairs(page:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextLabel") or c:IsA("TextButton") then
            c:Destroy()
        end
    end
    page.nextY = 4
    addSection(page, "players in server")

    playerRows = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            playerRows = playerRows + 1
            local row = addRow(page, 30)

            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Size = UDim2.new(1, -150, 1, 0)
            lbl.Position = UDim2.fromOffset(10, 0)
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextColor3 = THEME.Text
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Text = plr.Name
            lbl.Parent = row

            local state = Instance.new("TextLabel")
            state.BackgroundTransparency = 1
            state.Size = UDim2.fromOffset(60, 30)
            state.Position = UDim2.new(1, -130, 0, 0)
            state.Font = Enum.Font.Code
            state.TextSize = 12
            state.Text = ""
            state.Parent = row

            local btn = Instance.new("TextButton")
            btn.Size = UDim2.fromOffset(70, 20)
            btn.Position = UDim2.new(1, -80, 0.5, -10)
            btn.BackgroundColor3 = THEME.Panel
            btn.BorderSizePixel = 0
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 12
            btn.TextColor3 = THEME.Text
            btn.Text = "toggle"
            btn.Parent = row
            corner(btn, 6)

            local function paint()
                local on = EspLib.GetBundle(plr) ~= nil
                state.Text = on and "esp on" or "esp off"
                state.TextColor3 = on and THEME.Accent or THEME.Dim
            end
            btn.MouseButton1Click:Connect(function()
                if EspLib.GetBundle(plr) then
                    EspLib.RemoveESP(plr)
                else
                    EspLib.CreateESP(plr)
                end
                paint()
            end)
            paint()
        end
    end
    if playerRows == 0 then
        addInfo(page, "no other players")
    end
    page.CanvasSize = UDim2.fromOffset(0, page.nextY)
end

connections[#connections + 1] = Players.PlayerAdded:Connect(function()
    pcall(rebuildPlayers)
end)
connections[#connections + 1] = Players.PlayerRemoving:Connect(function()
    pcall(rebuildPlayers)
end)
rebuildPlayers()

