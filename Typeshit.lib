-- ── public menu handle ───────────────────────────────────────────────────
local UI = {
    SelectTab = selectTab,
    PlayerCount = function() return playerRows end,
    GetGui = function() return gui end,
    Destroy = function()
        for _, c in ipairs(connections) do
            pcall(c.Disconnect, c)
        end
        connections = {}
        pcall(function() gui:Destroy() end)
        GLOBAL.TypeShitUI = nil
    end,
}
GLOBAL.TypeShitUI = UI

print("[typeshit.cc private] menu loaded — RightControl to toggle")
